<Project Sdk="Microsoft.NET.Sdk">
  <!-- (s168) the installer's window: shows tools/installer/ui (served by installer.py on 127.0.0.1) in WebView2, the web view built
       into Windows 10/11 - no browser window, account, sync or extensions. Framework-dependent on the kit's .NET 8
       (Microsoft.NETCore.App + Microsoft.WindowsDesktop.App). WebView2 SDK: NuGet Microsoft.Web.WebView2 1.0.4258.31
       (sha256 56f7f4b8bf9aee4b8efefbbdd4f67d5f74ebd1b100ed0806da71bf76af481aa9), restored from a local folder:
       dotnet build -c Release -o <out> -p:RestoreSources=<folder with the .nupkg> -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>LegendOfKairiSetup</AssemblyName>
    <RootNamespace>KairiSetup</RootNamespace>
    <ApplicationIcon>kairi.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>Legend of Kairi Setup</Product>
    <AssemblyTitle>Legend of Kairi Setup</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
